# Фикстура индекса эталонов должна пережить checkout байт в байт: sha256
# catalog_meta.json вшит в заголовок catalog_index.bin (§13.2), и подстановка
# CRLF под Windows (core.autocrlf=true) развалила бы сверку хеша.
tests/fixtures/index/catalog_meta.json -text
tests/fixtures/index/catalog_index.bin binary

# Обёртка Gradle — POSIX-скрипт: при core.autocrlf=true checkout под Windows подставил
# бы CRLF, и `./gradlew` из Git Bash упал бы на `bad interpreter`.
app/android/gradlew text eol=lf

# Планы и спеки markdown должны сохранять LF под Windows
docs/superpowers/plans/*.md text eol=lf
docs/superpowers/specs/*.md text eol=lf
