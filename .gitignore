# Данные и артефакты обучения — никогда в git
data/
runs/
*.parquet
*.pt
*.pth
*.onnx
*.tflite
*.mlmodel
*.mlmodelc
*.bin
!catalog/**/*.bin
# Фикстура индекса — не артефакт прогона, а часть контракта §13.2: её читает
# Node-тест, собрать индекс сам он не может (нужны веса и torch).
!tests/fixtures/index/*.bin

# Python
__pycache__/
*.py[cod]
# Без завершающего слэша: по §16.2 окружения живут в ext4, а в репозитории
# лежит символическая ссылка на них. Паттерн `.venv/` совпадает только с
# каталогом и ссылку бы пропустил — git предложил бы закоммитить путь до
# домашнего каталога конкретной машины.
.venv
.venv-export
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Node / React Native
node_modules/
.expo/
*.log
npm-debug.log*
yarn-error.log*

# Android
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/local.properties
*.keystore
!debug.keystore

# iOS
app/ios/Pods/
app/ios/build/
app/ios/*.xcworkspace/xcuserdata/

# Редакторы и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db

# Локальные каталоги: документация и служебные данные инструментов не идут в git
.superpowers
docs/
.claude/
