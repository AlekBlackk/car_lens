<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <!--
        android:screenOrientation="portrait" зафиксирован намеренно, как у подавляющего
        большинства камерных приложений. Детекция от этого не страдает: кадр выпрямляется
        по физическому углу телефона (deviceDegrees), и машина находится в любом его
        положении. А рамки рисуются поверх превью, и пока окно поворачивается вместе с
        телефоном, их геометрия зависит ещё и от того, как CameraX доворачивает содержимое
        PreviewView — на устройстве это расходилось с расчётом mapBoxToView, и рамка
        съезжала (четвёртая строка таблицы приёмки M-1.6). Фиксированное окно оставляет
        ровно одну систему координат превью на все положения телефона.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:screenOrientation="portrait"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
