<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Своей строки с INTERNET у приложения нет: §9 разрешает MVP только CAMERA, а
      единственному потребителю разрешения — Metro dev server — оно объявлено в
      `src/debug/AndroidManifest.xml`, то есть в релиз не попадает.

      Строка ниже нужна ровно затем, чтобы быть вычеркнутой. Простого отсутствия
      объявления мало: в релизный APK разрешение подмешивал манифест транзитивной
      зависимости `com.google.android.datatransport:transport-backend-cct` (приходит с
      ML Kit внутри react-native-vision-camera). Замерено `aapt dump permissions` на
      app-release.apk: до `tools:node="remove"` строка INTERNET в релизе была.
      `tools:node="remove"` вычёркивает узел из манифестов библиотек при слиянии, а
      отладочный вариант приоритетнее main и своё объявление сохраняет.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <!--
      ACCESS_NETWORK_STATE вычёркивается там же и по той же причине: §9 перечисляет
      разрешения релиза исчерпывающе — «только CAMERA», — а строку подмешивает манифест
      той же `com.google.android.datatransport:transport-backend-cct`
      (`manifest-merger-release-report.txt:548`). Своего кода, читающего состояние сети, у
      приложения нет; телеметрия зависимости всё равно мертва без INTERNET.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:allowBackup="false"
      android:networkSecurityConfig="@xml/network_security_config"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <!--
        android:screenOrientation="portrait" зафиксирован намеренно, как у подавляющего
        большинства камерных приложений. Детекция от этого не страдает: кадр выпрямляется
        по физическому углу телефона (deviceDegrees), и машина находится в любом его
        положении. А рамки рисуются поверх превью, и пока окно поворачивается вместе с
        телефоном, их геометрия зависит ещё и от того, как CameraX доворачивает содержимое
        PreviewView — на устройстве это расходилось с расчётом mapBoxToView, и рамка
        съезжала (четвёртая строка таблицы приёмки M-1.6). Фиксированное окно оставляет
        ровно одну систему координат превью на все положения телефона.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:screenOrientation="portrait"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
