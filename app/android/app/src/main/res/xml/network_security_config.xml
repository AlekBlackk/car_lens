<?xml version="1.0" encoding="utf-8"?>
<!--
  Открытый HTTP запрещён без исключений. В релизной сборке у приложения нет и самого
  разрешения INTERNET (§9 спеки: разрешения MVP — только CAMERA), поэтому запрет здесь
  второй независимый рубеж, а не единственный.

  Отладочный вариант подменяет этот файл своим: Metro отдаёт бандл по обычному HTTP, и
  безоговорочный запрет в общем манифесте убил бы отладку.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
